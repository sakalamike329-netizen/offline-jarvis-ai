<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Button android:id="@+id/btnPickLlama" android:text="SELECT AI MODEL (.gguf)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txtLlamaPath" android:text="No model selected" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"/>
    <Button android:id="@+id/btnPickVosk" android:text="SELECT VOSK MODEL (folder)" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/txtVoskPath" android:text="No vosk model selected" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"/>
    <Button android:id="@+id/btnStart" android:text="START JARVIS SERVER" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"/>
    <TextView android:id="@+id/txtStatus" android:text="Status: Idle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp"/>
</LinearLayout>
