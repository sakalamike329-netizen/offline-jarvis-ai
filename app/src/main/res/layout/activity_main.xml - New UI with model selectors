<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="#0A0A0A"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="JARVIS ZM - SERVER" android:textColor="#00FF00"
        android:textSize="22sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnSelectLlama" android:text="📁 SELECT AI MODEL (.gguf)"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/txtLlamaPath" android:text="No model selected"
        android:textColor="#888" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnSelectVosk" android:text="📁 SELECT VOSK MODEL (folder)"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <TextView android:id="@+id/txtVoskPath" android:text="No vosk model selected"
        android:textColor="#888" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnStartServer" android:text="▶ START SERVER :8080"
        android:backgroundTint="#00FF00" android:textColor="#000"
        android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_marginTop="20dp"/>

    <TextView android:id="@+id/txtServerLog" android:text="Server stopped\nSelect models first"
        android:textColor="#00FF00" android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="16dp" android:background="#111" android:padding="10dp"/>
</LinearLayout>
